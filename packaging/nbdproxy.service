[Unit]
Description=Persistent local NBD reconnect proxy
After=network.target

[Service]
Type=simple
DynamicUser=yes
RuntimeDirectory=nbdproxy
RuntimeDirectoryMode=0755
ExecStart=/usr/local/bin/nbdproxy -listen unix:/run/nbdproxy/nbd.sock -upstream tcp:127.0.0.1:10809 -export disk1
Restart=on-failure
RestartSec=1s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
